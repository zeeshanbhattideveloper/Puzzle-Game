<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:ads="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/dialog_bg_rounded">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🎁 Daily Rewards"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:gravity="center"
        android:layout_marginBottom="12dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Login daily to collect rewards!"
        android:textSize="14sp"
        android:textColor="#666666"
        android:gravity="center"
        android:layout_marginBottom="16dp"/>

    <GridLayout
        android:id="@+id/gridRewards"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="4"
        android:rowCount="2"
        android:alignmentMode="alignMargins"
        android:useDefaultMargins="true">

        <TextView style="@style/RewardDayStyle" android:id="@+id/day1" android:text="Day 1\n🪙 10"/>
        <TextView style="@style/RewardDayStyle" android:id="@+id/day2" android:text="Day 2\n🪙 20"/>
        <TextView style="@style/RewardDayStyle" android:id="@+id/day3" android:text="Day 3\n🪙 30"/>
        <TextView style="@style/RewardDayStyle" android:id="@+id/day4" android:text="Day 4\n🪙 40"/>
        <TextView style="@style/RewardDayStyle" android:id="@+id/day5" android:text="Day 5\n🪙 50"/>
        <TextView style="@style/RewardDayStyle" android:id="@+id/day6" android:text="Day 6\n🪙 70"/>
        <TextView style="@style/RewardDayStyle" android:id="@+id/day7" android:text="Day 7\n🪙 100"/>
    </GridLayout>

    <!-- Normal collect button -->
    <Button
        android:id="@+id/btnCollect"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Collect Reward"
        android:textStyle="bold"
        android:textColor="#000000"
        android:backgroundTint="#FFD700"
        android:layout_marginTop="20dp"/>

    <!-- Watch Rewarded Ad button -->
    <Button
        android:id="@+id/btnWatchAd"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Watch Ad for 10 🪙"
        android:textStyle="bold"
        android:textColor="#000000"
        android:backgroundTint="#FFD700"
        android:layout_marginTop="16dp"
        android:visibility="gone"/>

</LinearLayout>
