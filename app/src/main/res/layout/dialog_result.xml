<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="24dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_bg"
    android:gravity="center">

    <!-- Title -->
    <TextView
        android:id="@+id/txtResultTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="You Win!"
        android:textSize="25sp"
        android:textStyle="bold"
        android:textColor="#0D0202"
        android:layout_marginBottom="12dp" />

    <!-- Message -->
    <TextView
        android:id="@+id/txtResultMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Great job!"
        android:textSize="16sp"
        android:textColor="#0F0606"
        android:layout_marginBottom="12dp" />

    <!-- Reward Message -->
    <TextView
        android:id="@+id/txtRewardMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="You got 10 🪙"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@android:color/holo_orange_dark"
        android:visibility="gone"
        android:layout_marginTop="-4dp"
        android:layout_gravity="center" />

    <!-- Buttons (Replay & Next) -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginTop="12dp">

        <Button
            android:id="@+id/btnReplay"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:text="Replay"
            android:textColor="#ffffff"
            android:backgroundTint="#FF5722"
            android:layout_marginEnd="12dp"
            android:padding="8dp"
            android:stateListAnimator="@null"/>

        <Button
            android:id="@+id/btnNext"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:text="Next"
            android:textColor="#ffffff"
            android:backgroundTint="#4CAF50"
            android:padding="8dp"
            android:stateListAnimator="@null"/>
    </LinearLayout>

    <!-- Watch Ad Button  -->
    <Button
        android:id="@+id/btnWatchAd"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Watch Ad for 10s ⏱️ "
        android:textStyle="bold"
        android:textColor="#000000"
        android:backgroundTint="#FFD700"
        android:layout_marginTop="16dp"
        android:visibility="gone"/>

</LinearLayout>
